      <Row title="Películas" items={data.movies} onPlay={setNowPlaying} />
      <Row title="Series" items={data.series} onPlay={setNowPlaying} />
    </div>
  );
}

function Row({ title, items, onPlay }: { title: string; items: Channel[]; onPlay: (c: Channel) => void }) {
