<file path="server/index.js">
// Proxy minimo para evitar CORS y mixed content (HTTP dentro de HTTPS).
// - Sigue redirecciones en el servidor (el navegador nunca ve la URL original).
// - Reescribe manifiestos HLS (.m3u8) para que segmentos y claves tambien pasen por el proxy.
// - Soporta Range. En produccion tambien sirve la carpeta dist/.
import express from "express";
import cors from "cors";
import path from "node:path";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { request as httpRequest } from "node:http";
import { request as httpsRequest } from "node:https";

const app = express();
const PORT = process.env.PORT || 3001;
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const DIST = path.join(__dirname, "..", "dist");
const MAX_REDIRECTS = 5;
const DEFAULT_UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) StreamBox/0.1";

app.use(cors({ exposedHeaders: ["Content-Range", "Accept-Ranges", "Content-Length"] }));
app.get("/health", (_req, res) => res.json({ ok: true }));

// ---------------------------------------------------------------- OpenSubtitles
app.use("/api", express.json({ limit: "1mb" }));

const OS_API = "https://api.opensubtitles.com/api/v1";
const OS_UA = "StreamBox v0.1";
const osTokens = new Map();

const osHeaders = (apiKey, extra = {}) => ({
  "Api-Key": apiKey,
  "User-Agent": OS_UA,
  Accept: "application/json",
  "Content-Type": "application/json",
  ...extra,
});

function decodeText(buf) {
  const utf8 = new TextDecoder("utf-8").decode(buf);
  if (!utf8.includes("\uFFFD")) return utf8;
  return new TextDecoder("windows-1252").decode(buf);
}

function srtToVtt(srt) {
  const text = srt.replace(/^\uFEFF/, "").replace(/\r\n?/g, "\n").trim();
  return "WEBVTT\n\n" + text.replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, "$1.$2") + "\n";
}

async function osLogin(apiKey, username, password) {
  const key = apiKey + ":" + username;
  const cached = osTokens.get(key);
  if (cached && Date.now() - cached.at < 20 * 3600 * 1000) return cached;
  const r = await fetch(`${OS_API}/login`, {
    method: "POST",
    headers: osHeaders(apiKey),
    body: JSON.stringify({ username, password }),
  });
  const d = await r.json().catch(() => ({}));
  if (!r.ok || !d.token) {
    const err = new Error(d.message || "Usuario o contrasena de OpenSubtitles incorrectos.");
    err.status = r.ok ? 401 : r.status;
    throw err;
  }
  const entry = { token: d.token, host: d.base_url || "api.opensubtitles.com", at: Date.now() };
  osTokens.set(key, entry);
  return entry;
}

app.post("/api/subs/search", async (req, res) => {
  const { apiKey, query, year, languages, season, episode } = req.body || {};
  if (!apiKey) return res.status(400).json({ error: "Falta la API key de OpenSubtitles (en Ajustes)." });
  if (!query) return res.status(400).json({ error: "Escribe el titulo a buscar." });

  const p = new URLSearchParams();
  p.set("query", String(query).toLowerCase());
  if (languages) p.set("languages", String(languages).toLowerCase());
  if (season && episode) {
    p.set("season_number", String(season));
    p.set("episode_number", String(episode));
    p.set("type", "episode");
  } else {
    p.set("type", "movie");
    if (year) p.set("year", String(year));
  }
  p.set("order_by", "download_count");
  const qs = new URLSearchParams([...p.entries()].sort(([a], [b]) => a.localeCompare(b))).toString();

  try {
    const r = await fetch(`${OS_API}/subtitles?${qs}`, { headers: osHeaders(apiKey) });
    const data = await r.json().catch(() => ({}));
    if (!r.ok) return res.status(r.status).json({ error: data.message || `OpenSubtitles respondio ${r.status}` });
    const items = (data.data || [])
      .map((d) => {
        const a = d.attributes || {};
        const f = (a.files || [])[0] || {};
        return {
          fileId: f.file_id,
          release: a.release || f.file_name || a.feature_details?.title || "",
          language: a.language || "",
          downloads: a.download_count || 0,
          hearingImpaired: !!a.hearing_impaired,
          trusted: !!a.from_trusted,
          ai: !!a.ai_translated,
          title: a.feature_details?.title,
          year: a.feature_details?.year,
        };
      })
      .filter((x) => x.fileId);
    res.json({ items });
  } catch (e) {
    res.status(502).json({ error: "No se pudo contactar con OpenSubtitles: " + e.message });
  }
});

app.post("/api/subs/download", async (req, res) => {
  const { apiKey, username, password, fileId } = req.body || {};
  if (!apiKey || !fileId) return res.status(400).json({ error: "Faltan datos (API key o subtitulo)." });
  try {
    let host = "api.opensubtitles.com";
    let auth = {};
    if (username && password) {
      const l = await osLogin(apiKey, username, password);
      host = l.host;
      auth = { Authorization: `Bearer ${l.token}` };
    }
    const r = await fetch(`https://${host}/api/v1/download`, {
      method: "POST",
      headers: osHeaders(apiKey, auth),
      body: JSON.stringify({ file_id: Number(fileId), sub_format: "srt" }),
    });
    const d = await r.json().catch(() => ({}));
    if (!r.ok || !d.link) {
      return res.status(r.ok ? 502 : r.status).json({ error: d.message || `OpenSubtitles respondio ${r.status}`, remaining: d.remaining });
    }
    const f = await fetch(d.link, { headers: { "User-Agent": OS_UA } });
    if (!f.ok) return res.status(502).json({ error: "No se pudo bajar el archivo de subtitulos." });
    const text = decodeText(Buffer.from(await f.arrayBuffer()));
    res.json({ vtt: srtToVtt(text), remaining: d.remaining, fileName: d.file_name });
  } catch (e) {
    res.status(e.status || 502).json({ error: e.message });
  }
});

const toProxy = (kind, absoluteUrl) => `/proxy/${kind}?url=${encodeURIComponent(absoluteUrl)}`;

function rewriteHls(text, base) {
  const abs = (u) => {
    if (/^data:/i.test(u)) return u;
    try {
      return toProxy("stream", new URL(u, base).toString());
    } catch {
      return u;
    }
  };
  return text
    .split(/\r?\n/)
    .map((line) => {
      const t = line.trim();
      if (!t) return line;
      if (t.startsWith("#")) return line.replace(/URI="([^"]+)"/g, (_m, u) => `URI="${abs(u)}"`);
      return abs(t);
    })
    .join("\n");
}

function makeHandler(kind) {
  return (req, res) => {
    const target = req.query.url;
    if (!target || typeof target !== "string") return res.status(400).json({ error: "Missing url query" });

    let current = null;
    // Usar res (no req): en Node >= 16 req emite 'close' nada mas leer la peticion.
    res.on("close", () => current && current.destroy());

    const fail = (code, msg) => {
      if (!res.headersSent) res.status(code).json({ error: msg });
      else res.end();
    };

    const go = (urlStr, hops) => {
      let parsed;
      try {
        parsed = new URL(urlStr);
      } catch {
        return fail(400, "Invalid url");
      }
      if (!/^https?:$/.test(parsed.protocol)) return fail(400, "Unsupported protocol");

      const isHttps = parsed.protocol === "https:";
      const headers = {
        "User-Agent": "VLC/3.0.20 LibVLC/3.0.20",
        Accept: "*/*",
        "Accept-Encoding": "identity",
      };
      if (req.headers.range) headers.Range = req.headers.range;

      current = (isHttps ? httpsRequest : httpRequest)(
        {
          method: req.method === "HEAD" ? "HEAD" : "GET",
          hostname: parsed.hostname,
          port: parsed.port || (isHttps ? 443 : 80),
          path: parsed.pathname + parsed.search,
          headers,
          timeout: kind === "playlist" ? 180000 : 20000,
        },
        (upRes) => {
          const code = upRes.statusCode || 200;

          if ([301, 302, 303, 307, 308].includes(code) && upRes.headers.location) {
            upRes.resume();
            if (hops >= MAX_REDIRECTS) return fail(508, "Too many redirects");
            return go(new URL(upRes.headers.location, parsed).toString(), hops + 1);
          }

          const ct = String(upRes.headers["content-type"] || "").toLowerCase();
          const looksLikeManifest =
            kind === "stream" && (ct.includes("mpegurl") || /\.m3u8?$/i.test(parsed.pathname));

          if (looksLikeManifest && req.method !== "HEAD") {
            const chunks = [];
            upRes.on("data", (c) => chunks.push(c));
            upRes.on("end", () => {
              const text = Buffer.concat(chunks).toString("utf8");
              const body = text.includes("#EXT-X-") ? rewriteHls(text, parsed) : text;
              res.status(code);
              res.setHeader("Content-Type", ct || "application/vnd.apple.mpegurl");
              res.setHeader("Cache-Control", "no-store");
              res.end(body);
            });
            upRes.on("error", () => fail(502, "Upstream error"));
            return;
          }

          for (const h of ["content-type", "content-length", "content-range", "accept-ranges", "etag", "last-modified"]) {
            if (upRes.headers[h]) res.setHeader(h, upRes.headers[h]);
          }
          res.status(code);
          upRes.pipe(res);
          upRes.on("error", () => res.end());
        }
      );

      current.on("timeout", () => current.destroy(new Error("Upstream timeout")));
      current.on("error", (err) => {
        const why = err.code || (err.errors && err.errors.map((e) => e.code + " " + e.address + ":" + e.port).join(", ")) || err.message || "desconocido";
        console.error("[proxy] fallo:", why);
        fail(502, "No se pudo conectar con el servidor: " + why);
      });
      current.end();
    };

    go(target, 0);
  };
}

for (const kind of ["playlist", "stream", "image"]) {
  app.get(`/proxy/${kind}`, makeHandler(kind));
  app.head(`/proxy/${kind}`, makeHandler(kind));
}

// Produccion: servir la app compilada
if (existsSync(DIST)) {
  app.use(express.static(DIST));
  app.get("*", (_req, res) => res.sendFile(path.join(DIST, "index.html")));
}

app.listen(PORT, () => {
  console.log(`StreamBox proxy escuchando en http://localhost:${PORT}`);
});
</file>

<file path="src/hooks/usePlayer.ts">
/**
 * Logica del reproductor:
 *  - hls.js para .m3u8, mpegts.js para MPEG-TS/FLV, <video> nativo para mp4/mkv
 *  - En TV en vivo prueba varios formatos del mismo canal (.m3u8 y .ts) antes de rendirse
 */
import { useCallback, useEffect, useRef, useState } from "react";
import Hls from "hls.js";
import mpegts from "mpegts.js";
import type { Channel } from "../types";
import { proxify } from "../services/proxy";

type MpegtsPlayer = ReturnType<typeof mpegts.createPlayer>;
type Kind = "hls" | "ts" | "flv" | "native";

export interface PlayerState {
  loading: boolean;
  error: string | null;
  isPlaying: boolean;
  currentTime: number;
  duration: number;
  volume: number;
  muted: boolean;
  playbackRate: number;
  audioTracks: { id: number; label: string }[];
  subtitleTracks: { id: number; label: string }[];
  activeAudio: number;
  activeSubtitle: number;
  extSubs: { id: string; label: string }[];
  activeExtSub: string | null;
  subOffset: number;
}

const INITIAL: PlayerState = {
  loading: true,
  error: null,
  isPlaying: false,
  currentTime: 0,
  duration: 0,
  volume: 1,
  muted: false,
  playbackRate: 1,
  audioTracks: [],
  subtitleTracks: [],
  activeAudio: -1,
  activeSubtitle: -1,
  extSubs: [],
  activeExtSub: null,
  subOffset: 0,
};

function detectKind(raw: string): Kind {
  const path = raw.split("?")[0].toLowerCase();
  if (path.endsWith(".m3u8") || /[?&]type=m3u8/i.test(raw)) return "hls";
  if (path.endsWith(".flv")) return "flv";
  let pathname = path;
  try {
    pathname = new URL(raw).pathname.toLowerCase();
  } catch {}
  if (pathname.endsWith(".ts") || /^\/(live\/)?[^/]+\/[^/]+\/\d+$/.test(pathname)) return "ts";
  return "native";
}

// Lista de URLs a probar, en orden. Para canales en vivo con formato Xtream
// (usuario/clave/id) se añaden las variantes .m3u8 y .ts.
function buildCandidates(channel: Channel): string[] {
  const list = [channel.url, ...(channel.altUrls ?? [])];
  if (channel.category === "live") {
    const m = channel.url.match(/^(https?:\/\/[^/]+)\/(?:live\/)?([^/]+)\/([^/]+)\/(\d+)(?:\.(?:ts|m3u8))?(?:\?.*)?$/i);
    if (m) {
      const base = `${m[1]}/live/${m[2]}/${m[3]}/${m[4]}`;
      list.push(`${base}.m3u8`, `${base}.ts`);
    }
  }
  return Array.from(new Set(list.filter(Boolean)));
}

export function usePlayer(channel: Channel | null) {
  const videoRef = useRef<HTMLVideoElement | null>(null);
  const hlsRef = useRef<Hls | null>(null);
  const tsRef = useRef<MpegtsPlayer | null>(null);
  const fallbackRef = useRef<((msg: string) => void) | null>(null);
  const extTracksRef = useRef<{ id: string; el: HTMLTrackElement; url: string; offset: number }[]>([]);
  const [reloadKey, setReloadKey] = useState(0);
  const [state, setState] = useState<PlayerState>(INITIAL);

  const destroyEngines = useCallback(() => {
    hlsRef.current?.destroy();
    hlsRef.current = null;
    if (tsRef.current) {
      try {
        tsRef.current.pause();
        tsRef.current.unload();
        tsRef.current.detachMediaElement();
        tsRef.current.destroy();
      } catch {}
      tsRef.current = null;
    }
  }, []);

  const clearExtSubs = useCallback(() => {
    for (const t of extTracksRef.current) {
      try {
        t.el.remove();
        URL.revokeObjectURL(t.url);
      } catch {}
    }
    extTracksRef.current = [];
    setState((s) => ({ ...s, extSubs: [], activeExtSub: null, subOffset: 0 }));
  }, []);

  useEffect(
    () => () => {
      destroyEngines();
      clearExtSubs();
    },
    [destroyEngines, clearExtSubs]
  );

  useEffect(() => {
    const video = videoRef.current;
    if (!video || !channel) return;

    let cancelled = false;
    clearExtSubs();
    let idx = 0;
    let timer: number | undefined;
    const candidates = buildCandidates(channel);

    const clearTimer = () => {
      if (timer) window.clearTimeout(timer);
      timer = undefined;
    };
    const failFinal = (msg: string) => {
      clearTimer();
      const tried = candidates.length > 1 ? ` (se probaron ${candidates.length} formatos)` : "";
      setState((s) => ({ ...s, error: msg + tried, loading: false }));
    };
    const next = (msg: string) => {
      if (cancelled) return;
      clearTimer();
      if (idx + 1 < candidates.length) {
        idx++;
        start();
      } else {
        failFinal(msg);
      }
    };
    fallbackRef.current = next;

    const onPlaying = () => clearTimer();
    video.addEventListener("playing", onPlaying);

    const start = async () => {
      destroyEngines();
      video.removeAttribute("src");
      video.load();
      setState((s) => ({ ...s, loading: true, error: null, audioTracks: [], subtitleTracks: [], currentTime: 0, duration: 0 }));

      try {
        const raw = candidates[idx];
        const kind = detectKind(raw);
        const url = await proxify(raw, "stream");
        if (cancelled) return;

        if (channel.category === "live") {
          timer = window.setTimeout(() => next("El canal no responde"), 15000);
        }

        if (kind === "hls") {
          if (Hls.isSupported()) {
            const hls = new Hls({ enableWorker: true });
            hlsRef.current = hls;
            let retries = 0;
            hls.loadSource(url);
            hls.attachMedia(video);
            hls.on(Hls.Events.MANIFEST_PARSED, () => {
              if (cancelled) return;
              const audio = hls.audioTracks.map((t, i) => ({ id: i, label: t.name || t.lang || `Audio ${i + 1}` }));
              const subs = hls.subtitleTracks.map((t, i) => ({ id: i, label: t.name || t.lang || `Sub ${i + 1}` }));
              setState((s) => ({ ...s, audioTracks: audio, subtitleTracks: subs, activeAudio: 0, activeSubtitle: -1 }));
              video.play().catch(() => {});
            });
            hls.on(Hls.Events.ERROR, (_e, data) => {
              if (!data.fatal) return;
              if (data.type === Hls.ErrorTypes.NETWORK_ERROR && retries < 2) {
                retries++;
                hls.startLoad();
              } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR && retries < 2) {
                retries++;
                hls.recoverMediaError();
              } else {
                next(`Error HLS: ${data.details}`);
              }
            });
          } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
            video.src = url;
            video.play().catch(() => {});
          } else {
            next("HLS no soportado en este navegador");
          }
        } else if (kind === "ts" || kind === "flv") {
          if (mpegts.isSupported()) {
            const player = mpegts.createPlayer(
              { type: kind === "flv" ? "flv" : "mpegts", url, isLive: true },
              { enableWorker: true, liveBufferLatencyChasing: true }
            );
            tsRef.current = player;
            player.attachMediaElement(video);
            player.load();
            player.on(mpegts.Events.ERROR, (_type: string, detail: string, info: any) =>
              next(`Error TS/FLV: ${detail}${info?.code ? ` (HTTP ${info.code})` : ""}${info?.msg ? ` - ${info.msg}` : ""}`)
            );
            video.play().catch(() => {});
          } else {
            video.src = url;
            video.play().catch(() => {});
          }
        } else {
          video.src = url;
          video.play().catch(() => {});
        }
      } catch (e: any) {
        next(e?.message || "Error al cargar el stream");
      }
    };

    start();

    return () => {
      cancelled = true;
      clearTimer();
      video.removeEventListener("playing", onPlaying);
      fallbackRef.current = null;
    };
  }, [channel?.id, reloadKey]);

  // Eventos del <video>
  useEffect(() => {
    const video = videoRef.current;
    if (!video) return;

    const onPlay = () => setState((s) => ({ ...s, isPlaying: true, loading: false }));
    const onPause = () => setState((s) => ({ ...s, isPlaying: false }));
    const onWaiting = () => setState((s) => ({ ...s, loading: true }));
    const onCanPlay = () => setState((s) => ({ ...s, loading: false }));
    const onTime = () =>
      setState((s) => ({ ...s, currentTime: video.currentTime, duration: isFinite(video.duration) ? video.duration : 0 }));
    const onVolume = () => setState((s) => ({ ...s, volume: video.volume, muted: video.muted }));
    const onError = () => {
      if (!video.getAttribute("src") && !hlsRef.current && !tsRef.current) return;
      if (fallbackRef.current) fallbackRef.current("Error de reproducción");
      else setState((s) => ({ ...s, error: "Error de reproducción", loading: false }));
    };

    video.addEventListener("play", onPlay);
    video.addEventListener("pause", onPause);
    video.addEventListener("waiting", onWaiting);
    video.addEventListener("canplay", onCanPlay);
    video.addEventListener("timeupdate", onTime);
    video.addEventListener("volumechange", onVolume);
    video.addEventListener("error", onError);
    return () => {
      video.removeEventListener("play", onPlay);
      video.removeEventListener("pause", onPause);
      video.removeEventListener("waiting", onWaiting);
      video.removeEventListener("canplay", onCanPlay);
      video.removeEventListener("timeupdate", onTime);
      video.removeEventListener("volumechange", onVolume);
      video.removeEventListener("error", onError);
    };
  }, []);

  const actions = {
    playPause: () => {
      const v = videoRef.current;
      if (!v) return;
      if (v.paused) v.play().catch(() => {});
      else v.pause();
    },
    seek: (t: number) => {
      const v = videoRef.current;
      if (v && isFinite(v.duration) && v.duration > 0) v.currentTime = Math.max(0, Math.min(v.duration, t));
    },
    setVolume: (vol: number) => {
      const v = videoRef.current;
      if (v) v.volume = Math.max(0, Math.min(1, vol));
    },
    setMuted: (m: boolean) => {
      const v = videoRef.current;
      if (v) v.muted = m;
    },
    setPlaybackRate: (r: number) => {
      const v = videoRef.current;
      if (v) v.playbackRate = r;
      setState((s) => ({ ...s, playbackRate: r }));
    },
    setAudioTrack: (id: number) => {
      if (hlsRef.current) {
        hlsRef.current.audioTrack = id;
        setState((s) => ({ ...s, activeAudio: id }));
      }
    },
    setSubtitleTrack: (id: number) => {
      if (hlsRef.current) {
        hlsRef.current.subtitleTrack = id;
        setState((s) => ({ ...s, activeSubtitle: id }));
      }
    },
    requestPiP: async () => {
      const v = videoRef.current;
      if (!v) return;
      try {
        if (document.pictureInPictureElement) await document.exitPictureInPicture();
        else if (v.requestPictureInPicture) await v.requestPictureInPicture();
      } catch {}
    },
    // Subtitulos externos (OpenSubtitles o archivo local), en formato WebVTT
    addSubtitle: (label: string, vtt: string) => {
      const v = videoRef.current;
      if (!v) return;
      for (const t of extTracksRef.current) t.el.track.mode = "disabled";
      Array.from(v.textTracks).forEach((t) => {
        if (t.mode === "showing") t.mode = "disabled";
      });
      const url = URL.createObjectURL(new Blob([vtt], { type: "text/vtt" }));
      const el = document.createElement("track");
      el.kind = "subtitles";
      el.label = label;
      el.src = url;
      el.default = true;
      v.appendChild(el);
      el.track.mode = "showing";
      const id = String(Date.now()) + Math.random().toString(36).slice(2, 5);
      extTracksRef.current.push({ id, el, url, offset: 0 });
      setState((s) => ({ ...s, extSubs: [...s.extSubs, { id, label }], activeExtSub: id, subOffset: 0, activeSubtitle: -1 }));
    },
    setExtSubtitle: (id: string | null) => {
      for (const t of extTracksRef.current) t.el.track.mode = t.id === id ? "showing" : "disabled";
      const cur = extTracksRef.current.find((t) => t.id === id);
      setState((s) => ({ ...s, activeExtSub: id, subOffset: cur?.offset ?? 0 }));
    },
    // Adelanta o atrasa los subtitulos (segundos, p. ej. +0.5 / -0.5)
    shiftSubtitles: (delta: number) => {
      const cur = extTracksRef.current.find((t) => t.id === state.activeExtSub);
      if (!cur) return;
      const cues = cur.el.track.cues;
      if (!cues) return;
      for (const c of Array.from(cues)) {
        c.startTime = Math.max(0, c.startTime + delta);
        c.endTime = Math.max(0.05, c.endTime + delta);
      }
      cur.offset = Math.round((cur.offset + delta) * 10) / 10;
      setState((s) => ({ ...s, subOffset: cur.offset }));
    },
    retry: () => setReloadKey((k) => k + 1),
  };

  return { videoRef, state, actions };
}
