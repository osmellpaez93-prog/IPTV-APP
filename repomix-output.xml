  language: "es",
  theme: "dark",
  proxyUrl: "/proxy",
  tmdbApiKey: "",
  parentalPin: "",
  hiddenCategories: [],
};

export async function getSettings(): Promise<Settings> {
  const s = await db.settings.get("main");
  if (!s) {
    await db.settings.put({ id: "main", ...DEFAULT_SETTINGS });
    return { ...DEFAULT_SETTINGS };
  }
  const { id, ...rest } = s;
  return { ...DEFAULT_SETTINGS, ...rest };
}

