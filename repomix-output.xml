<file path="update-fase2.ps1">
<#
  StreamBox - actualizacion Fase 2
  Anade modo Xtream, detalle de series y reproduccion de canales en vivo con varios formatos.
  Uso (en la raiz del repo):
      powershell -ExecutionPolicy Bypass -File .\update-fase2.ps1
  Si un archivo cambia, guarda una copia .bak. No hace falta npm install.
#>
$ErrorActionPreference = "Stop"
$root = (Get-Location).Path
if (-not (Test-Path (Join-Path $root "package.json"))) {
    Write-Host "ERROR: ejecuta esto en la raiz del proyecto (donde esta package.json)." -ForegroundColor Red
    return
}
Write-Host "Actualizando StreamBox en: $root" -ForegroundColor Cyan

function Write-ProjectFile {
    param([string]$RelPath, [string]$B64)
    $bytes = [Convert]::FromBase64String(($B64 -replace '\s', ''))
    $full = Join-Path $root $RelPath
    $dir = Split-Path $full -Parent
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
    if (Test-Path $full) {
        $old = [System.IO.File]::ReadAllBytes($full)
        if (-not [System.Linq.Enumerable]::SequenceEqual($old, $bytes)) { Copy-Item $full "$full.bak" -Force }
    }
    [System.IO.File]::WriteAllBytes($full, $bytes)
    Write-Host "  + $RelPath" -ForegroundColor Green
}

